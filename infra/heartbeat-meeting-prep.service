[Unit]
Description=Meeting-prep heartbeat — fires 30 min before each meeting
After=openclaw-gateway.service

[Service]
Type=oneshot
ExecStartPre=/bin/mkdir -p ${STATE_HOME}/.brain-bootstrap-raw/logs ${STATE_HOME}/.brain-bootstrap-raw/state
ExecStart=${STATE_HOME}/bin/heartbeat-meeting-prep.sh
TimeoutStartSec=180
