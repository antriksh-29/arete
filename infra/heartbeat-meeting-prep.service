[Unit]
Description=Meeting-prep heartbeat — fires 30 min before each meeting
After=openclaw-gateway.service

[Service]
Type=oneshot
ExecStartPre=/bin/mkdir -p /home/botuser/.brain-bootstrap-raw/logs /home/botuser/.brain-bootstrap-raw/state
ExecStart=/home/botuser/bin/heartbeat-meeting-prep.sh
TimeoutStartSec=180
