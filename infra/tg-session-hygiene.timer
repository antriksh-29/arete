[Unit]
Description=Conditional Telegram-session reset — weekly hygiene timer
Documentation=https://github.com/antriksh-29/personal-assistant/blob/main/docs/ADR-001-browser-stack.md

[Timer]
# Sunday 04:00 IST (quiet hour, before the 7am brain-collectors and 8am briefing).
OnCalendar=Sun *-*-* 04:00:00 Asia/Kolkata
Persistent=true
Unit=tg-session-hygiene.service

[Install]
WantedBy=timers.target
