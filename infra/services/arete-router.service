[Unit]
Description=Arete tenant router — single Telegram bot → many tenant containers
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=arete
Group=arete
WorkingDirectory=/opt/arete/services/router
EnvironmentFile=/etc/arete-secrets/router.env
ExecStart=/usr/bin/node /opt/arete/services/router/dist/index.js
Restart=on-failure
RestartSec=5s

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/log/arete /var/tenants
# Router needs docker.sock + the system's CA bundle
SupplementaryGroups=docker

# Resource limits
LimitNOFILE=65536

# Stdout / stderr → journald (journalctl -u arete-router -f)
StandardOutput=journal
StandardError=journal
SyslogIdentifier=arete-router

[Install]
WantedBy=multi-user.target
