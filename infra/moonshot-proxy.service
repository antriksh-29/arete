[Unit]
Description=Moonshot API proxy with circuit breaker + OpenAI failover
# Start before openclaw-gateway so the proxy is always available when
# the gateway tries to reach Moonshot. Gateway will retry if proxy is
# briefly unavailable but better to avoid the race.
Before=openclaw-gateway.service
PartOf=openclaw-gateway.service

[Service]
Type=simple
# The launch wrapper reads MOONSHOT_API_KEY + OPENAI_API_KEY from the
# arete-cred vault, then execs node. Wrapping avoids systemd's
# EnvironmentFile-on-first-boot race AND PATH issues (arete-cred + node
# are often only on PATH via shell init that systemd doesn't run).
ExecStart=%h/personal-assistant/infra/moonshot-proxy-launch.sh
Restart=on-failure
RestartSec=5s
# Limit restart frequency so a misconfigured proxy doesn't pin a CPU
StartLimitIntervalSec=60
StartLimitBurst=5
# Keep the log volume low — proxy logs are diagnostic, not transactional
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
