# Caddyfile template for personal AI assistant.
# Deployed in Phase 1 to /etc/caddy/Caddyfile on the VPS.
# Caddy auto-fetches a Let's Encrypt cert on first request.
#
# Substitute ${PLATFORM_DOMAIN} with your actual domain, e.g.:
#   
# Tip: `sed -i 's/${PLATFORM_DOMAIN}//g' /etc/caddy/Caddyfile`
#
# OpenClaw listens on localhost:18789. Caddy terminates TLS and reverse-proxies.

${PLATFORM_DOMAIN} {
    reverse_proxy localhost:18789 {
        # Telegram webhooks need the original Host header preserved
        header_up Host {host}
        # OpenClaw expects to know the real client IP for allowlist logging
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
    }

    # Health endpoint passthrough (UptimeRobot pings this every 5 min)
    # OpenClaw exposes /health natively; if it doesn't, swap to a static respond block
    # respond /health 200

    log {
        output file /var/log/caddy/access.log {
            roll_size 100mb
            roll_keep 5
        }
        format json
        # Drop /health from logs to keep volume sane (UptimeRobot pings 12k+/mo)
        # filter for /health if needed via matcher
    }

    # Reasonable timeouts for long-running agent loops
    # (synthesis can take 30-60s; default Caddy timeout is fine but explicit is better)
    @longrunning path /webhook* /agent*
    handle @longrunning {
        reverse_proxy localhost:18789 {
            transport http {
                read_timeout 120s
                write_timeout 120s
                dial_timeout 5s
            }
        }
    }

    # Security headers — appropriate for a webhook endpoint, not a browser app
    header {
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy no-referrer
        # No HSTS — domain is bot-only, no browser visits expected
        -Server
    }
}

# Redirect plain HTTP root to HTTPS (Caddy does this by default but explicit doesn't hurt)
# Block direct IP-based access (anyone hitting the IP without the right Host)
http://${PLATFORM_DOMAIN} {
    redir https://${PLATFORM_DOMAIN}{uri} permanent
}
