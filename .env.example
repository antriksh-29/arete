# Local-dev .env template. Copy to .env and fill in.
#
# DO NOT commit .env — it's gitignored. Source these from 1Password (item titles
# in parens are the canonical 1Password records).

# === Tenant identity (for local-dev test tenant) ===

# Tenant ID for the local test container. Any string; mirrors what the
# provisioner would assign in prod.
TENANT_ID=test-1

# Per-tenant GitHub state repo. Create one manually for local-dev (the
# provisioner handles this in prod).
# Example: https://github.com/antriksh-29/arete-test-1-assistant.git
TENANT_REPO_URL=https://github.com/antriksh-29/arete-test-1-assistant.git


# === Platform secrets ===

# GitHub PAT for cloning + pushing the tenant repo. (1Password: ARETE_GITHUB_PAT)
ARETE_GITHUB_PAT=github_pat_XXXXXXXXXXXX

# Anthropic API key (1Password: shared platform key — set up in Phase F)
ARETE_SHARED_ANTHROPIC_KEY=sk-ant-XXXXXXXXXXXX

# OpenAI API key (1Password: shared platform key — set up in Phase F). Optional.
ARETE_SHARED_OPENAI_KEY=

# Supabase Postgres URL. (1Password: ARETE_SUPABASE → db_url)
# Leave blank to use the local docker-compose postgres service.
ARETE_SUPABASE_DB_URL=


# === Build args ===

# GBrain SHA to pin in the image build. Mirrors tools/.gbrain-pin.
GBRAIN_SHA=0fb0c83

# Model used by the injection-fixture boot gate.
INJECTION_MODEL=claude-sonnet-4-6
